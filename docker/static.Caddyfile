# Internal static file server; TLS and public routing live in edge/Caddyfile.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	# Theme files only ship under assets/, so serve the shared icon at the path browsers probe
	rewrite /favicon.ico /assets/img/favicon.ico
	file_server
	header /assets/* Cache-Control "public, max-age=86400"

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
